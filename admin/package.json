{
  "name": "student-nexus-desktop",
  "version": "2.0.0",
  "description": "Student Nexus Desktop App with Electron & React",
  "homepage": "./",
  "main": "main.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "npm run build && electron-builder"
  },
  "keywords": [
    "electron",
    "react",
    "student-nexus",
    "desktop"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@supabase/supabase-js": "^2.108.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "react-scripts": "5.0.1",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "extends": null,
    "appId": "com.studentnexus.admin",
    "productName": "STUDENT NEXUS ADMIN DASHBOARD V2.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "images/student nexus logo.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "images/student nexus logo.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "images/student nexus logo.png"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
